# Ignore the virtual environment folder
.venv/
venv/
ENV/

# Ignore VS Code workspace settings and cache
.vscode/
*.code-workspace

# ==========================================
# Python Standard Ignores (Highly Recommended)
# ==========================================

# Byte-compiled / optimized / DLL files (Python runtime caches)
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging files
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==========================================
# Testing and Jupyter Notebooks
# ==========================================

# Inline checkpoints and test caches
.pytest_cache/
.tox/
.coverage
.cache
htmlcov/
.ipynb_checkpoints/

# ==========================================
# Environment Variables & Security (CRITICAL)
# ==========================================

# Never commit local secrets, tokens, or private config files
.env
.env.local
.env.*.local
*.secret

# ==========================================
# Machine Learning Data (IMPORTANT FOR YOUR PROJECT)
# ==========================================

# Raw and processed datasets (too large for GitHub)
datasets/
*.parquet